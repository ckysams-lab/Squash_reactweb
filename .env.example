# .env.example — 範本檔（必須提交，內容為空值）
# 複製此檔為 .env.local 並填入真實值；.env.local 已被 .gitignore 忽略，切勿提交。
#
# 取得方式：Firebase Console → 專案設定 → 一般 → 您的應用程式 → SDK 設定與配置
VITE_FIREBASE_CONFIG='{"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":"","measurementId":""}'

# 多租戶 ID（單一來源，見 src/config.js）
VITE_APP_ID='bcklas-squash-core-v1'

# 應用程式版本（用於快取失效判斷；須與 src/config.js 預設值一致）
VITE_APP_VERSION='1.19'
